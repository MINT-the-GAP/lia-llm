{
  "name": "lia-llm",
  "version": "0.5.8",
  "private": true,
  "description": "Local semantic assessment for open-ended LiaScript questions",
  "license": "MIT",
  "app": "dist/index.js",
  "scripts": {
    "prepare:webllm": "node scripts/prepare-webllm.mjs",
    "build": "npm run prepare:webllm && parcel build src/index.ts --target app --no-scope-hoist",
    "postbuild": "node scripts/copy-ort-assets.mjs",
    "dev": "npm run prepare:webllm && node scripts/copy-ort-assets.mjs && parcel watch src/index.ts --target app --no-scope-hoist",
    "typecheck": "npm run prepare:webllm && tsc --noEmit",
    "pretest": "npm run prepare:webllm",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/scoring.test.mts",
    "test:browser-smoke": "node test/run-browser-calibration.mjs test/browser-api-smoke.html cpu",
    "test:browser-hardening": "node test/run-browser-hardening.mjs",
    "test:browser-model": "node test/run-browser-calibration.mjs",
    "test:browser-operators": "node test/run-browser-calibration.mjs test/browser-operator-calibration.html webgpu",
    "test:browser-adversarial": "node test/run-browser-calibration.mjs test/browser-adversarial-calibration.html webgpu",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.84",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.64",
    "buffer": "^6.0.3",
    "parcel": "2.16.4",
    "playwright-core": "1.62.0",
    "typescript": "5.9.3"
  },
  "alias": {
    "@huggingface/transformers": "./node_modules/@huggingface/transformers/dist/transformers.web.js",
    "onnxruntime-web/webgpu": "./node_modules/onnxruntime-web/dist/ort.webgpu.min.js",
    "process": false
  },
  "targets": {
    "app": {
      "context": "browser",
      "outputFormat": "global",
      "includeNodeModules": true,
      "isLibrary": false,
      "optimize": true,
      "sourceMap": false
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
